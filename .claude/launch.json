{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "edge",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "edge-netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "netlify-cli@latest",
        "dev",
        "--offline",
        "--no-open"
      ],
      "port": 8888
    }
  ]
}